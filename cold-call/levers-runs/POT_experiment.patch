   // chance that one paid spin takes the pot: one in `oneInPerDollar` per dollar of cost
   // oneInPerDollar <= 0 (or not a number) switches the pot off: chance 0, never 1
   function potHitChance(pullCfg, costCents) { const o = (pullCfg || CFG.pull).pot.oneInPerDollar; return o > 0 && Number.isFinite(o) ? Math.min(1, (costCents / 100) / o) : 0; }
+  // EXPERIMENT (levers 8.11, not committed): prize of one pot hit. A: floorCents > 0 lifts the cap to at least floorCents; B: capCents > 0 is the cap in money for every bet
+  function potPrize(pullCfg, bal, betCents) {
+    const P = (pullCfg || CFG.pull).pot; let cap = P.maxPayX * betCents;
+    if (P.floorCents > 0) cap = Math.max(cap, P.floorCents);
+    if (P.capCents > 0) cap = P.capCents;
+    return Math.min(bal, cap);
+  }
 
